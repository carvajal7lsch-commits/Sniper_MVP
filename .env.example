# Fuente de datos del sitio: "demo" (archivos locales) o "api" (backend del cliente).
FUENTE_DATOS=demo

# URL base del backend del cliente. Solo se usa con FUENTE_DATOS=api.
API_URL=https://sniperpro-backend.onrender.com/

# Máximo de KB que puede descargar el inicio antes de mostrarse (lo revisa scripts/medir.mjs).
PRESUPUESTO_INICIAL_KB=250
