{
  "name": "sniperpro-demo",
  "version": "0.4.1",
  "scripts": {
    "dev": "astro dev",
    "assets": "node scripts/fetch-assets.mjs",
    "build": "astro build && node scripts/medir.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verificar": "npm run check && npm run test && npm run format:check && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/allura": "^5.3.0",
    "astro": "^7.4.10"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "prettier": "^3.10.0",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "all",
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  }
}
