---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/allura/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Sniper Pro Academy | Academia de trading en Cúcuta',
  description = 'Aprende trading de índices sintéticos y Forex desde cero, con mentores que operan en vivo. Comunidad gratuita en Telegram, cursos y app de señales.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060a1f" />
    <!-- Demo de propuesta: no indexar para no competir con el sitio oficial -->
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/media/logo.webp" as="image" type="image/webp" />
  </head>
  <body>
    <a class="skip" href="#contenido">
      Saltar al contenido
    </a>
    <div class="demo-bar">
      <p class="wrap">
        Demo de rediseño propuesta para Sniper Pro. No es el sitio oficial. <a href="/mejoras/">Ver qué mejoró</a>
      </p>
    </div>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--cian);
    color: var(--noche);
    padding: 0.6rem 1rem;
    font-weight: 700;
    z-index: 100;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
  }
  .demo-bar {
    background: var(--azul);
    color: #fff;
    font-size: var(--t-xs);
  }
  .demo-bar p {
    margin: 0;
    padding: 0.45rem 0;
    text-align: center;
  }
  .demo-bar a {
    color: #fff;
    font-weight: 700;
    text-underline-offset: 0.2em;
  }
</style>
