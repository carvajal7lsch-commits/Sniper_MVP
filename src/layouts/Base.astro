---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/allura/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { repositorios } from '../infraestructura/contenedor';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Sniper Pro Academy | Academia de trading en Cúcuta',
  description = 'Aprende trading de índices sintéticos y Forex desde cero, con mentores que operan en vivo. Comunidad gratuita en Telegram, cursos y app de señales.',
} = Astro.props;
const categorias = await repositorios.cursos.listarCategorias();
const cursos = await repositorios.cursos.listar();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05060d" />
    <!-- Demo de propuesta: no indexar para no competir con el sitio oficial -->
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/media/logo.webp" as="image" type="image/webp" />
  </head>
  <body>
    <a class="skip" href="#contenido">
      Saltar al contenido
    </a>
    <Header categorias={categorias} cursos={cursos} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <aside class="demo-pill" data-demo-pill aria-label="Aviso de demo">
      <a href="/mejoras/">
        Demo de rediseño <span>Ver qué mejoró</span>
      </a>
      <button type="button" aria-label="Ocultar aviso de demo" data-cerrar-demo>
        ×
      </button>
    </aside>
    <script>
      // El aviso se puede ocultar mientras dure la visita; si el navegador no deja guardar, solo se oculta.
      const aviso = document.querySelector<HTMLElement>('[data-demo-pill]');
      try {
        if (sessionStorage.getItem('demoOculta') === '1') {
          aviso?.remove();
        }
      } catch {}
      document.querySelector('[data-cerrar-demo]')?.addEventListener('click', () => {
        aviso?.remove();
        try {
          sessionStorage.setItem('demoOculta', '1');
        } catch {}
      });
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--cian);
    color: var(--noche);
    padding: 0.6rem 1rem;
    font-weight: 700;
    z-index: 100;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
  }
  .demo-pill {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 40;
    display: flex;
    align-items: center;
    background: rgb(20 23 34 / 0.92);
    backdrop-filter: blur(10px);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 999px;
    font-size: 0.78rem;
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.6);
  }
  .demo-pill a {
    padding: 0.45rem 0.4rem 0.45rem 0.9rem;
    color: #9aa1c4;
    text-decoration: none;
  }
  .demo-pill a span {
    color: var(--hueso);
    font-weight: 700;
    margin-left: 0.35rem;
  }
  .demo-pill a:hover span {
    color: var(--cian);
  }
  .demo-pill button {
    width: 30px;
    height: 30px;
    margin-right: 0.15rem;
    border: 0;
    border-radius: 50%;
    background: none;
    color: #9aa1c4;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }
  .demo-pill button:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.08);
  }
</style>
