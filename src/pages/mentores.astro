---
// El equipo: un retrato por mentor que lleva a su perfil y a sus cursos.
import Base from '../layouts/Base.astro';
import { nombreCompleto } from '../dominio/mentor';
import { resumirMentor } from '../dominio/catalogo';
import { repositorios } from '../infraestructura/contenedor';

const mentores = await repositorios.mentores.listar();
const cursos = await repositorios.cursos.listar();
const cuantos = (slug: string) => resumirMentor(cursos.filter((c) => c.mentor === slug)).cursos;
---

<Base
  title="Mentores | Sniper Pro Academy"
  description="Los mentores de Sniper Pro y sus cursos: índices sintéticos, Forex, mentalidad y finanzas."
>
  <section class="eqp">
    <div class="wrap">
      <div class="eqp-cabeza" data-revelar>
        <h1>El equipo</h1>
        <p>Cada mentor tiene sus propios cursos. Entra a su perfil para ver su ruta.</p>
      </div>
      <ul class="eqp-grid">
        {mentores.map((m, i) => (
          <li style={`--k:${i}`}>
            <a class:list={['eqp-carta', { fundador: m.esFundador }]} href={`/mentores/${m.slug}/`}>
              <img
                src={`/media/mentores/${m.slug}-400.webp`}
                srcset={`/media/mentores/${m.slug}-400.webp 400w, /media/mentores/${m.slug}-800.webp 800w`}
                sizes={m.esFundador ? '(max-width: 700px) 90vw, 560px' : '(max-width: 700px) 45vw, 280px'}
                width="400"
                height="500"
                alt=""
                loading={i < 3 ? 'eager' : 'lazy'}
              />
              <span class="eqp-info">
                <span class="eqp-nombre">
                  <span class="first">{m.nombre}</span>
                  {m.apellido && <span class="last">{m.apellido}</span>}
                </span>
                <span class="eqp-rol">
                  <strong>{m.rol}</strong>
                  {m.enfoque}
                </span>
                <span class="eqp-cursos">{cuantos(m.slug) === 1 ? '1 curso' : `${cuantos(m.slug)} cursos`}</span>
              </span>
              <span class="sr-only">{nombreCompleto(m)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .eqp {
    padding-block: clamp(2rem, 5vw, 3.5rem) var(--sec);
  }
  .eqp-cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    margin-bottom: 1.75rem;
  }
  .eqp-cabeza h1 {
    font-size: var(--t-xl);
  }
  .eqp-cabeza p {
    margin: 0;
    color: var(--bruma);
  }
  .eqp-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.75rem;
  }
  .eqp-grid li:first-child {
    grid-column: span 2;
    grid-row: span 2;
  }
  .eqp-carta {
    position: relative;
    display: block;
    height: 100%;
    min-height: 300px;
    overflow: hidden;
    border-radius: var(--r-md);
    background: #000;
    color: #fff;
    text-decoration: none;
    isolation: isolate;
  }
  .eqp-carta img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
    z-index: -2;
    filter: grayscale(0.35) brightness(0.8);
    transition:
      filter 0.4s,
      transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .eqp-carta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(5 6 13 / 0.95) 0%, rgb(5 6 13 / 0.2) 45%, transparent 70%);
  }
  .eqp-carta:hover img,
  .eqp-carta:focus-visible img {
    filter: none;
    transform: scale(1.03);
  }
  .eqp-carta:hover,
  .eqp-carta:focus-visible {
    box-shadow:
      0 24px 50px -18px rgb(35 72 255 / 0.75),
      0 0 0 1.5px rgb(34 225 255 / 0.55);
  }
  .eqp-info {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.1rem 1.1rem;
  }
  .eqp-nombre {
    display: grid;
    line-height: 0.9;
  }
  .first {
    font-size: clamp(1.1rem, 0.9rem + 0.7vw, 1.6rem);
    font-weight: 900;
    font-stretch: 125%;
    text-transform: uppercase;
    color: var(--cian);
  }
  .last {
    font-family: 'Allura', cursive;
    font-size: clamp(1.3rem, 1rem + 0.9vw, 1.9rem);
    margin: -0.12em 0 0 1.2em;
  }
  .fundador .first {
    font-size: clamp(1.8rem, 1.2rem + 2vw, 3rem);
  }
  .fundador .last {
    font-size: clamp(2rem, 1.3rem + 2vw, 3.2rem);
  }
  .eqp-rol {
    display: grid;
    font-size: 0.82rem;
    color: #c9cfea;
  }
  .eqp-rol strong {
    color: #fff;
  }
  .eqp-cursos {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--cian);
  }
  @media (max-width: 1000px) {
    .eqp-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 700px) {
    .eqp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .eqp-grid li:first-child {
      grid-row: auto;
    }
    .eqp-carta {
      min-height: 240px;
    }
  }
</style>
