---
// Qué mejoró: el sitio actual contra la propuesta. Las cifras del sitio actual se midieron en
// sniperproacademy.com (inicio, 11 nov 2026, navegador de escritorio); las de la propuesta las
// mide scripts/medir.mjs en cada compilación. Aquí no va nada de seguridad: eso se habla en privado.
import Base from '../layouts/Base.astro';
import medidas from '../generado/medidas.json';
import { repositorios } from '../infraestructura/contenedor';
import { agruparEdiciones } from '../dominio/catalogo';

const antes = { pesoMB: 71.7, solicitudes: 99, js: 24, errores: 2 };
const d = medidas;
const fmt = (kb: number) => (kb >= 1024 ? `${(kb / 1024).toFixed(1).replace('.', ',')} MB` : `${Math.round(kb)} KB`);
const veces = Math.round((antes.pesoMB * 1024) / d.totalKB);
const proporcion = Math.max((d.totalKB / (antes.pesoMB * 1024)) * 100, 0.6);

const cursos = await repositorios.cursos.listar();
const mentores = await repositorios.mentores.listar();
const resenas = await repositorios.resenas.listarDestacadas();
const programas = agruparEdiciones(cursos).length;

const cifras = [
  { k: 'Lo que se descarga antes de ver la página', a: '71,7 MB', b: fmt(d.inicialKB) },
  { k: 'Archivos que pide el navegador', a: String(antes.solicitudes), b: String(d.solicitudes) },
  { k: 'Archivos de JavaScript', a: String(antes.js), b: String(d.js) },
  { k: 'Errores en la consola', a: String(antes.errores), b: '0' },
];

const cambios = [
  {
    t: 'Cursos',
    a: 'El botón "Cursos" abre una página titulada "Instructores" y no muestra ningún curso.',
    b: `${programas} cursos de ${mentores.length} mentores, con filtro por mentor, tema, nivel y búsqueda. Cada curso tiene su página con las clases, la duración y las reseñas.`,
  },
  {
    t: 'Carga',
    a: 'Un GIF de 49,8 MB que solo muestra texto, videos convertidos en GIF y unos 8 segundos de pantalla en blanco.',
    b: `Texto real y video que se descarga al llegar a su sección. Lo primero que se ve pesa ${fmt(d.inicialKB)}.`,
  },
  {
    t: 'Textos',
    a: 'Quiénes somos, misión, visión y los nombres de los mentores están dentro de imágenes.',
    b: 'Todo es texto: lo leen Google, los traductores y los lectores de pantalla.',
  },
  {
    t: 'Reseñas',
    a: 'Más de 90 en un carrusel, con duplicados, varias de una palabra y dos quejas al frente.',
    b: `${resenas.length} seleccionadas, corriendo en una franja con estilo de notificación de Telegram.`,
  },
  {
    t: 'Ingreso',
    a: 'Página de la plantilla en inglés: "Login & Register", "Lost your password?", "Remember me".',
    b: 'Ingreso y registro en español, con los mismos campos, en una sola pantalla.',
  },
  {
    t: 'Confianza',
    a: 'Sin aviso de riesgo. Copyright 2025, la pestaña dice "Websniper" y quedan textos de la plantilla como "Your shopping cart".',
    b: 'Aviso de riesgo en todas las páginas y todo en español.',
  },
  {
    t: 'Google y WhatsApp',
    a: 'Marcado en inglés, sin descripción, el mismo título en todas las páginas y sin vista previa al compartir un enlace.',
    b: 'Título y descripción propios por página, vista previa con imagen, mapa del sitio y una ficha de cada curso y mentor para Google.',
  },
];
---

<Base
  title="Qué mejoró | Demo Sniper Pro"
  description="Comparación entre el sitio actual de Sniper Pro y esta propuesta de rediseño."
>
  <section class="mj">
    <div class="wrap">
      <header class="mj-cabeza" data-revelar>
        <h1>Qué mejoró</h1>
        <p>
          La página de inicio pasa de 71,7 MB a {fmt(d.totalKB)}: unas {veces} veces más liviana, con el mismo contenido
          y la misma marca.
        </p>
      </header>

      <figure class="peso" data-revelar>
        <div class="peso-fila">
          <span class="peso-nombre">Sitio actual</span>
          <span class="peso-barra peso-antes" style="--w:100%"></span>
          <span class="peso-valor">71,7 MB</span>
        </div>
        <div class="peso-fila">
          <span class="peso-nombre">Propuesta</span>
          <span class="peso-barra peso-ahora" style={`--w:${proporcion}%`}></span>
          <span class="peso-valor">{fmt(d.totalKB)}</span>
        </div>
        <figcaption>Peso de la página de inicio, a escala.</figcaption>
      </figure>

      <dl class="cifras" data-revelar>
        {cifras.map((c) => (
          <div>
            <dt>{c.k}</dt>
            <dd>
              <span class="c-ahora">{c.b}</span>
              <span class="c-antes">antes {c.a}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="cb" aria-labelledby="cb-titulo">
    <div class="wrap">
      <h2 id="cb-titulo">Lo que cambia para quien entra</h2>
      <div class="cb-tabla" role="table" aria-label="Antes y ahora">
        <div class="cb-fila cb-encabezado" role="row">
          <span role="columnheader">
            <span class="sr-only">Tema</span>
          </span>
          <span role="columnheader">Sitio actual</span>
          <span role="columnheader">Propuesta</span>
        </div>
        {cambios.map((c) => (
          <div class="cb-fila" role="row">
            <span class="cb-tema" role="rowheader">
              {c.t}
            </span>
            <span class="cb-antes" role="cell">
              <span class="cb-etq">Sitio actual</span>
              {c.a}
            </span>
            <span class="cb-ahora" role="cell">
              <span class="cb-etq">Propuesta</span>
              {c.b}
            </span>
          </div>
        ))}
      </div>
      <p class="nota">
        Sitio actual medido el 11 de noviembre de 2026 en un navegador de escritorio. La propuesta se mide sola cada vez
        que se compila.
      </p>
    </div>
  </section>
</Base>

<style>
  .mj {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 3.5rem);
  }
  .mj-cabeza h1 {
    font-size: var(--t-xl);
    margin-bottom: 0.75rem;
  }
  .mj-cabeza p {
    margin: 0;
    max-width: 40em;
    font-size: var(--t-md);
    color: var(--bruma);
  }

  /* Barras a escala: la de la propuesta es casi una raya, y ese es el punto */
  .peso {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    display: grid;
    gap: 0.9rem;
  }
  .peso-fila {
    display: grid;
    grid-template-columns: 7.5rem 1fr 5.5rem;
    align-items: center;
    gap: 1rem;
  }
  .peso-nombre {
    font-size: var(--t-sm);
    font-weight: 600;
  }
  .peso-barra {
    height: 26px;
    width: var(--w);
    border-radius: 4px;
    transform-origin: left;
  }
  .peso-antes {
    background: repeating-linear-gradient(-45deg, #3a2030 0 6px, #2a1824 6px 12px);
    box-shadow: inset 0 0 0 1px rgb(255 77 106 / 0.35);
  }
  .peso-ahora {
    min-width: 4px;
    background: var(--cian);
    box-shadow: 0 0 14px rgb(34 225 255 / 0.6);
  }
  .peso-valor {
    font-weight: 800;
    font-stretch: 112%;
    text-align: right;
  }
  .peso-fila:first-child .peso-valor {
    color: #ff8a9c;
  }
  .peso-fila:nth-child(2) .peso-valor {
    color: var(--cian);
  }
  .peso figcaption {
    font-size: var(--t-xs);
    color: #6f79a6;
  }
  :global(.js) .peso:not(.visible) .peso-barra {
    transform: scaleX(0);
  }
  .peso .peso-barra {
    transition: transform 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s;
  }

  /* Cifras: el número nuevo grande y el viejo pequeño debajo */
  .cifras {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(2.5rem, 6vw, 3.5rem) 0 0;
    border-top: 1px solid var(--linea);
  }
  .cifras > div {
    padding: 1.25rem 1.25rem 0 0;
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.6rem;
  }
  .cifras > div + div {
    padding-left: 1.25rem;
    border-left: 1px solid var(--linea);
  }
  .cifras dt {
    font-size: var(--t-sm);
    color: var(--bruma);
  }
  .cifras dd {
    margin: 0;
    display: grid;
    gap: 0.15rem;
  }
  .c-ahora {
    font-size: clamp(1.8rem, 1.3rem + 1.6vw, 2.6rem);
    font-weight: 900;
    font-stretch: 112%;
    line-height: 1;
  }
  .c-antes {
    font-size: var(--t-sm);
    color: #6f79a6;
    text-decoration: line-through;
    text-decoration-color: rgb(255 77 106 / 0.6);
  }

  /* Antes y ahora, fila por fila */
  .cb {
    padding-block: clamp(2rem, 5vw, 3.5rem) var(--sec);
  }
  .cb h2 {
    font-size: var(--t-lg);
    margin-bottom: 1.25rem;
  }
  .cb-fila {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem 2.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--linea);
  }
  .cb-encabezado {
    padding-block: 0 0.75rem;
    font-size: var(--t-xs);
    font-weight: 700;
    color: #6f79a6;
  }
  .cb-tema {
    font-weight: 800;
    font-stretch: 112%;
  }
  .cb-antes {
    color: #8088ad;
  }
  .cb-ahora {
    color: var(--hueso);
  }
  .cb-etq {
    display: none;
  }
  .nota {
    margin: 1.25rem 0 0;
    font-size: var(--t-xs);
    color: #6f79a6;
  }

  @media (max-width: 900px) {
    .cifras {
      grid-template-columns: 1fr 1fr;
    }
    .cifras > div + div:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .cifras > div:nth-child(n + 3) {
      padding-top: 1.5rem;
    }
  }
  @media (max-width: 760px) {
    .peso-fila {
      grid-template-columns: 1fr auto;
    }
    .peso-barra {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .cb-encabezado {
      display: none;
    }
    .cb-fila {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
    .cb-etq {
      display: block;
      font-size: var(--t-xs);
      font-weight: 700;
      color: #6f79a6;
      margin-bottom: 0.15rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .peso:not(.visible) .peso-barra {
      transform: none;
    }
  }
</style>
