---
// Catálogo completo. En la academia cada mentor tiene sus propios cursos, así que el filtro
// principal es el mentor (fila de caras). Debajo, tema, nivel y búsqueda. Cada curso muestra
// su edición vigente; las anteriores van plegadas dentro de la tarjeta.
import Base from '../layouts/Base.astro';
import CursoTarjeta from '../components/CursoTarjeta.astro';
import { NIVELES as niveles } from '../dominio/curso';
import { agruparEdiciones, ordenarRuta } from '../dominio/catalogo';
import { nombreCompleto } from '../dominio/mentor';
import { repositorios } from '../infraestructura/contenedor';

const cursos = await repositorios.cursos.listar();
const categorias = await repositorios.cursos.listarCategorias();
const mentores = await repositorios.mentores.listar();
const catNombre = Object.fromEntries(categorias.map((c) => [c.id, c.nombre]));
const ordenTemas = categorias.map((c) => c.id);

// Por mentor (en el orden del equipo) y, dentro de cada uno, su ruta: tema y nivel.
const programas = mentores.flatMap((m) =>
  agruparEdiciones(
    ordenarRuta(
      cursos.filter((c) => c.mentor === m.slug),
      ordenTemas,
    ),
  ).map((programa) => ({ programa, mentor: m })),
);
---

<Base
  title="Cursos de trading | Sniper Pro Academy"
  description="Todos los cursos de Sniper Pro por mentor: índices sintéticos, Forex, mentalidad, práctica y finanzas."
>
  <section class="cat">
    <div class="wrap">
      <div class="cat-cabeza" data-revelar>
        <h1>Cursos</h1>
        <p>
          {programas.length} cursos de {mentores.length} mentores. Elige con quién quieres aprender.
        </p>
      </div>

      <div class="mentores" role="group" aria-label="Filtrar por mentor" data-revelar>
        <button class="mf" type="button" aria-pressed="true" data-value="">
          <span class="mf-todos" aria-hidden="true">
            {mentores.length}
          </span>
          <span class="mf-nombre">Todos</span>
        </button>
        {mentores.map((m) => (
          <button class="mf" type="button" aria-pressed="false" data-value={m.slug} data-nombre={nombreCompleto(m)}>
            <img src={`/media/mentores/${m.slug}-cara.webp`} alt="" width="56" height="56" />
            <span class="mf-nombre">{m.nombre}</span>
            <span class="sr-only">{m.apellido}</span>
          </button>
        ))}
      </div>

      <div class="filtros" role="group" aria-label="Filtrar por tema y nivel">
        <div class="chips" data-group="cat">
          <button class="chip" type="button" aria-pressed="true" data-value="">
            Todos los temas
          </button>
          {categorias.map((c) => (
            <button class="chip" type="button" aria-pressed="false" data-value={c.id}>
              {c.nombre}
            </button>
          ))}
        </div>
        <div class="filtros-2">
          <label class="sr-only" for="nivel">
            Nivel
          </label>
          <select id="nivel" class="input">
            <option value="">Todos los niveles</option>
            {niveles.map((n) => (
              <option value={n}>{n}</option>
            ))}
          </select>
          <label class="sr-only" for="q">
            Buscar curso
          </label>
          <input id="q" class="input" type="search" placeholder="Buscar curso" autocomplete="off" />
        </div>
      </div>

      <p class="conteo" aria-live="polite">
        <span id="conteo">{programas.length} cursos</span>
        <a class="link" id="perfil" href="/mentores/" hidden>
          Ver su perfil
        </a>
      </p>

      <ul class="grid-cursos" id="lista">
        {programas.map(({ programa, mentor }) => (
          <CursoTarjeta programa={programa} mentor={mentor} categoria={catNombre[programa.actual.categoria]} />
        ))}
      </ul>

      <div class="vacio" id="vacio" hidden>
        <p>
          <strong>Ningún curso coincide con esos filtros.</strong>
        </p>
        <p class="muted">Prueba con otro tema o nivel, o escríbenos y te recomendamos uno.</p>
        <button class="btn btn-ghost" type="button" id="limpiar">
          Quitar filtros
        </button>
      </div>

      <p class="nota muted">
        Catálogo tomado de la plataforma de la academia el 12 de noviembre de 2026. La inscripción y las clases siguen
        en la plataforma.
      </p>
    </div>
  </section>
</Base>

<script>
  import { normalizar } from '../dominio/busqueda';

  const estado = { mentor: '', cat: '', nivel: '', q: '' };
  const items = [...document.querySelectorAll<HTMLLIElement>('#lista > .ct')];
  const conteo = document.getElementById('conteo')!;
  const perfil = document.getElementById('perfil') as HTMLAnchorElement;
  const vacio = document.getElementById('vacio')!;
  const nivel = document.getElementById('nivel') as HTMLSelectElement;
  const q = document.getElementById('q') as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-group="cat"] .chip')];
  const caras = [...document.querySelectorAll<HTMLButtonElement>('.mf')];

  function pintar() {
    let n = 0;
    for (const li of items) {
      const ok =
        (!estado.mentor || li.dataset.mentor === estado.mentor) &&
        (!estado.cat || li.dataset.cat === estado.cat) &&
        (!estado.nivel || li.dataset.nivel === estado.nivel) &&
        (!estado.q || li.dataset.text!.includes(estado.q));
      li.hidden = !ok;
      if (ok) n++;
    }
    const cara = caras.find((c) => c.dataset.value === estado.mentor);
    const de = estado.mentor && cara ? ` de ${cara.dataset.nombre}` : '';
    conteo.textContent = (n === 1 ? '1 curso' : `${n} cursos`) + de;
    perfil.hidden = !estado.mentor;
    perfil.href = `/mentores/${estado.mentor}/`;
    vacio.hidden = n !== 0;
  }

  // Los filtros quedan en la URL para poder compartir el enlace (/cursos/?mentor=luis-algarin&tema=forex).
  function guardarUrl() {
    const url = new URL(location.href);
    url.hash = '';
    for (const [clave, valor] of [
      ['mentor', estado.mentor],
      ['tema', estado.cat],
    ]) {
      if (valor) {
        url.searchParams.set(clave, valor);
      } else {
        url.searchParams.delete(clave);
      }
    }
    history.replaceState(null, '', url);
  }

  function marcarMentor(slug: string) {
    estado.mentor = caras.some((c) => c.dataset.value === slug) ? slug : '';
    caras.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.value === estado.mentor)));
  }
  function marcarTema(tema: string) {
    estado.cat = chips.some((c) => c.dataset.value === tema) ? tema : '';
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.value === estado.cat)));
  }

  caras.forEach((c) =>
    c.addEventListener('click', () => {
      marcarMentor(c.dataset.value || '');
      guardarUrl();
      pintar();
    }),
  );
  chips.forEach((b) =>
    b.addEventListener('click', () => {
      marcarTema(b.dataset.value || '');
      guardarUrl();
      pintar();
    }),
  );
  nivel.addEventListener('change', () => {
    estado.nivel = nivel.value;
    pintar();
  });
  q.addEventListener('input', () => {
    estado.q = normalizar(q.value);
    pintar();
  });
  document.getElementById('limpiar')!.addEventListener('click', () => {
    estado.nivel = estado.q = '';
    nivel.value = '';
    q.value = '';
    marcarMentor('');
    marcarTema('');
    guardarUrl();
    pintar();
  });

  // Llegadas desde el menú, los perfiles o el buscador: ?mentor=…, ?tema=…, ?q=… (y #tema de enlaces viejos).
  function aplicarUrl() {
    const params = new URLSearchParams(location.search);
    const consulta = params.get('q') ?? '';
    q.value = consulta;
    estado.q = normalizar(consulta);
    estado.nivel = nivel.value = '';
    marcarMentor(params.get('mentor') ?? '');
    marcarTema(params.get('tema') ?? decodeURIComponent(location.hash.slice(1)));
    pintar();
  }
  aplicarUrl();

  // Estando ya en el catálogo, los enlaces del menú filtran sin recargar la página.
  document.addEventListener('click', (evento) => {
    const enlace = (evento.target as Element).closest<HTMLAnchorElement>('a[href]');
    if (!enlace || evento.defaultPrevented || evento.metaKey || evento.ctrlKey || evento.shiftKey) return;
    const destino = new URL(enlace.href);
    if (destino.origin !== location.origin || destino.pathname !== location.pathname) return;
    evento.preventDefault();
    history.pushState(null, '', destino);
    aplicarUrl();
    document.querySelector('.cat')?.scrollIntoView({ behavior: 'smooth' });
  });
  window.addEventListener('popstate', aplicarUrl);
  window.addEventListener('hashchange', aplicarUrl);
</script>

<style>
  .cat {
    padding-block: clamp(2rem, 5vw, 3.5rem) var(--sec);
  }
  .cat-cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    margin-bottom: 1.5rem;
  }
  .cat-cabeza h1 {
    font-size: var(--t-xl);
  }
  .cat-cabeza p {
    margin: 0;
    color: var(--bruma);
  }

  /* Fila de mentores: la cara es el filtro */
  .mentores {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    padding: 0.25rem 0.1rem 0.75rem;
    margin-bottom: 0.75rem;
    scrollbar-width: thin;
  }
  .mf {
    flex: none;
    display: grid;
    justify-items: center;
    gap: 0.45rem;
    width: 84px;
    padding: 0.4rem 0.2rem;
    border: 0;
    border-radius: var(--r-sm);
    background: none;
    color: var(--bruma);
    font: inherit;
    cursor: pointer;
  }
  .mf img,
  .mf-todos {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 15%;
    background: #000;
    outline: 2px solid var(--linea);
    outline-offset: 2px;
    transition:
      outline-color 0.2s,
      transform 0.2s;
  }
  .mf-todos {
    display: grid;
    place-items: center;
    font-weight: 800;
    color: var(--hueso);
    background: var(--tinta);
  }
  .mf-nombre {
    font-size: 0.82rem;
    font-weight: 600;
  }
  .mf:hover img,
  .mf:hover .mf-todos {
    transform: translateY(-2px);
    outline-color: #2c3a7a;
  }
  .mf[aria-pressed='true'] {
    color: var(--hueso);
  }
  .mf[aria-pressed='true'] img,
  .mf[aria-pressed='true'] .mf-todos {
    outline-color: var(--cian);
  }

  .filtros {
    display: grid;
    gap: 0.9rem;
    margin-bottom: 1.1rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filtros-2 {
    display: grid;
    grid-template-columns: 220px minmax(0, 360px);
    gap: 0.75rem;
  }
  .conteo {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    font-size: var(--t-sm);
    color: var(--bruma);
    margin: 0 0 1rem;
  }
  .grid-cursos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }
  .vacio {
    padding: 2.5rem 0;
  }
  .vacio p {
    margin: 0 0 0.5rem;
  }
  .nota {
    font-size: var(--t-xs);
    margin-top: 2rem;
    max-width: 70ch;
  }
  @media (max-width: 600px) {
    .filtros-2 {
      grid-template-columns: 1fr;
    }
    .chips {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.25rem;
    }
    .chip {
      flex: none;
    }
  }
</style>
