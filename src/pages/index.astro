---
import Base from '../layouts/Base.astro';
import HeroCine from '../components/HeroCine.astro';
import MentorCard from '../components/MentorCard.astro';
import EquipoPanel from '../components/EquipoPanel.astro';
import Comunidad from '../components/Comunidad.astro';
import AppSenales from '../components/AppSenales.astro';
import Eventos from '../components/Eventos.astro';
import Icon from '../components/Icon.astro';
import { links } from '../config/sitio';
import { repositorios } from '../infraestructura/contenedor';

const mentores = await repositorios.mentores.listar();
const resenas = await repositorios.resenas.listarDestacadas();
const fundador = mentores.find((m) => m.esFundador) ?? mentores[0];
const equipo = mentores.filter((m) => m !== fundador);

// Las reseñas que nombran a Miguel acompañan al fundador; el resto va al chat de la comunidad.
const sobreMiguel = resenas.filter((r) => r.texto.includes('Miguel')).slice(0, 2);
const paraElChat = resenas.filter((r) => !sobreMiguel.includes(r));

const colores = ['#6ec9ff', '#ffb86b', '#b9a6ff', '#7ee3a2', '#ff8fa3', '#f5d76e'];
const colorDe = (nombre: string) => colores[[...nombre].reduce((a, c) => a + c.charCodeAt(0), 0) % colores.length];
---

<Base>
  <HeroCine />

  <!-- FUNDADOR -->
  <section class="sec fundador" id="fundador">
    <div class="wrap f-grid">
      <MentorCard m={fundador} grande />
      <div class="f-copy">
        <h2>Detrás de cada clase hay alguien que opera todos los días</h2>
        <p class="lead">
          Miguel Monsalve fundó Sniper Pro en Cúcuta. Enseña índices sintéticos y Forex, y armó un equipo de mentores
          que explica igual que él: simple, frente al gráfico y sin vender humo.
        </p>

        <ul class="coment" aria-label="Reseñas de estudiantes sobre Miguel">
          {sobreMiguel.map((r) => (
            <li class="cm">
              <span class="cm-av" style={`--c:${colorDe(r.nombre)}`} aria-hidden="true">
                {r.nombre.charAt(0)}
              </span>
              <div class="cm-cuerpo">
                <p class="cm-cabeza">
                  <strong>{r.nombre}</strong>
                  <span class="cm-insignia">Estudiante</span>
                </p>
                <p class="cm-texto">{r.texto}</p>
                <p class="cm-pie">Reseña publicada en la plataforma</p>
              </div>
            </li>
          ))}
        </ul>

        <div class="f-links">
          <a href={links.instagram} target="_blank" rel="noopener">
            <Icon name="instagram" />
            <span>
              <strong>78 mil</strong> lo siguen en Instagram
            </span>
          </a>
          <a href={links.youtube} target="_blank" rel="noopener">
            <Icon name="youtube" />
            <span>
              <strong>Canal de YouTube</strong> clases y análisis
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- EQUIPO -->
  <section class="sec equipo" aria-labelledby="eq-titulo">
    <div class="wrap">
      <div class="eq-cabeza">
        <div>
          <h2 id="eq-titulo">El equipo</h2>
          <p class="lead">Cada mentor lidera un área de la academia.</p>
        </div>
        <a class="link" href="/mentores/">
          Ver perfiles completos
        </a>
      </div>
      <EquipoPanel mentores={equipo} />
    </div>
  </section>

  <Comunidad resenas={paraElChat} />
  <AppSenales />
  <Eventos />
</Base>

<style>
  /* Fundador: entra desde el desenfoque mientras el hero se apaga */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .fundador .f-grid {
        animation: f-entrada linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }
  @keyframes f-entrada {
    from {
      opacity: 0;
      filter: blur(16px);
      transform: translateY(8vh);
    }
  }

  .f-grid {
    display: grid;
    grid-template-columns: minmax(0, 420px) 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .f-copy {
    display: grid;
    gap: 1.5rem;
  }
  .f-copy h2 {
    max-width: 16ch;
  }
  .f-copy .lead {
    margin: 0;
  }

  /* Comentarios: con avatar, nombre e insignia, como se ven en una plataforma real */
  .coment {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .cm {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 0.8rem;
    align-items: start;
  }
  .cm-av {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 800;
    color: #0b1020;
    background: var(--c);
  }
  .cm-cuerpo {
    padding: 0.7rem 1rem 0.65rem;
    border-radius: 4px 16px 16px 16px;
    background: #121831;
    border: 1px solid var(--linea);
  }
  .cm-cabeza {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.25rem;
    font-size: var(--t-sm);
  }
  .cm-insignia {
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: rgb(34 241 255 / 0.12);
    color: var(--cian);
    font-size: 0.72rem;
    font-weight: 700;
  }
  .cm-texto {
    margin: 0;
    line-height: 1.5;
  }
  .cm-pie {
    margin: 0.4rem 0 0;
    font-size: 0.75rem;
    color: var(--bruma);
  }

  .f-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .f-links a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--linea);
    border-radius: var(--r-sm);
    text-decoration: none;
    font-size: var(--t-sm);
    color: var(--bruma);
  }
  .f-links a:hover {
    border-color: #2c3a7a;
    color: var(--hueso);
  }
  .f-links :global(svg) {
    width: 22px;
    height: 22px;
    color: var(--cian);
  }
  .f-links span {
    display: grid;
    line-height: 1.3;
  }
  .f-links strong {
    color: var(--hueso);
  }

  /* Equipo */
  .eq-cabeza {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }
  .eq-cabeza h2 {
    margin-bottom: 0.75rem;
  }
  .eq-cabeza .lead {
    margin: 0;
  }

  @media (max-width: 960px) {
    .f-grid {
      grid-template-columns: 1fr;
    }
    .f-grid :global(.mc) {
      max-width: 420px;
    }
  }
</style>
