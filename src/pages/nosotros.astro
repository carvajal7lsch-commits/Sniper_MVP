---
// Nosotros: el contenido real de /somos del sitio actual (hoy está dentro de tres imágenes:
// QUIENESSOMOS.jpg, MISION.jpg y VISION.jpg), pasado a texto. Se omite la cifra de efectividad
// del 80 % hasta que el cliente la respalde. Cierra con los presenciales, igual que el inicio.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Eventos from '../components/Eventos.astro';
import { cifras } from '../config/sitio';

const comoEnsenamos = [
  {
    t: 'Desde cero',
    d: 'Métodos sencillos para que cualquier persona empiece, aunque no tenga ningún conocimiento de trading.',
  },
  {
    t: 'Sobre el gráfico',
    d: 'Técnicas y estrategias para leer los gráficos e identificar posibles entradas y salidas del mercado.',
  },
  {
    t: 'De la mano',
    d: 'Un equipo de traders y analistas que acompaña a cada estudiante en el proceso, desde cero hasta operar con un plan.',
  },
  {
    t: 'Mentalidad primero',
    d: 'Formarte primero como persona y luego como trader: la mentalidad es el énfasis de la academia.',
  },
];
---

<Base
  title="Nosotros | Sniper Pro Academy"
  description="Sniper Pro es una academia de trading de Cúcuta que lleva a sus estudiantes desde cero en Forex e índices sintéticos."
>
  <section class="qs">
    <div class="wrap qs-in">
      <div class="qs-texto" data-revelar>
        <h1>Quiénes somos</h1>
        <p class="qs-lead">
          Sniper Pro es una academia de trading que enseña desde cero hasta nivel profesional en los mercados
          financieros, con foco en Forex e índices sintéticos.
        </p>
        <p>
          Estamos en Cúcuta, Norte de Santander, y hoy reunimos estudiantes de toda Latinoamérica. Estamos adecuando
          instalaciones físicas para quienes prefieren aprender en persona.
        </p>
        <dl class="qs-cifras">
          {cifras.map((c) => (
            <div>
              <dt>{c.texto}</dt>
              <dd>{c.valor}</dd>
            </div>
          ))}
        </dl>
      </div>
      <figure class="qs-foto" data-revelar="lado">
        <picture>
          <source media="(max-width: 700px)" srcset="/media/familia-800.webp" />
          <img
            src="/media/familia-1600.webp"
            width="1600"
            height="578"
            alt="El equipo de mentores de Sniper Pro"
            loading="eager"
          />
        </picture>
      </figure>
    </div>
  </section>

  <section class="mv" aria-label="Misión y visión">
    <div class="wrap mv-in">
      <article class="mv-bloque" data-revelar>
        <h2>Misión</h2>
        <p>
          Ofrecer la mejor experiencia de aprendizaje a nuestros estudiantes, con principios éticos y plena
          transparencia, para lograr confianza, credibilidad y formar traders rentables en los mercados financieros.
        </p>
      </article>
      <article class="mv-bloque" data-revelar>
        <h2>Visión</h2>
        <p>
          En una trayectoria de 5 años, ser el movimiento más grande a nivel mundial en formación de traders, con más de
          cinco mil traders rentables.
        </p>
      </article>
    </div>
  </section>

  <section class="ce" aria-labelledby="ce-titulo">
    <div class="wrap">
      <h2 id="ce-titulo" data-revelar>
        <span>Cómo enseñamos</span>
      </h2>
      <ul class="ce-lista" data-revelar>
        {comoEnsenamos.map((p) => (
          <li>
            <Icon name="mira" />
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Eventos />
</Base>

<style>
  /* Primera pantalla: texto e imagen del equipo */
  .qs {
    padding-block: clamp(2rem, 5vh, 3.5rem) clamp(2.5rem, 6vh, 4rem);
  }
  .qs-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }
  .qs-texto {
    display: grid;
    gap: 1rem;
  }
  .qs-texto h1 {
    font-size: var(--t-xl);
  }
  .qs-texto p {
    margin: 0;
    max-width: 36em;
    color: var(--bruma);
  }
  .qs-texto .qs-lead {
    font-size: var(--t-md);
    color: var(--hueso);
    line-height: 1.5;
  }
  .qs-cifras {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.25rem;
    margin: 0.75rem 0 0;
  }
  .qs-cifras div {
    display: flex;
    flex-direction: column-reverse;
  }
  .qs-cifras dd {
    margin: 0;
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.3rem);
    font-weight: 900;
    font-stretch: 112%;
    color: var(--cian);
  }
  .qs-cifras dt {
    font-size: 0.85rem;
    color: var(--bruma);
  }
  .qs-foto {
    margin: 0;
  }
  .qs-foto img {
    width: 100%;
    height: clamp(320px, calc(100svh - 64px - 9rem), 560px);
    object-fit: cover;
    object-position: center 25%;
    border-radius: var(--r-md);
    background: #000;
    box-shadow:
      0 24px 50px -18px rgb(35 72 255 / 0.75),
      0 0 0 1.5px rgb(34 225 255 / 0.4);
  }

  /* Misión y visión: el mismo azul a morado de sus piezas, con el titular en cian */
  .mv {
    padding-block: clamp(1rem, 3vh, 2rem);
  }
  .mv-in {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .mv-bloque {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-radius: var(--r-md);
    background:
      linear-gradient(180deg, transparent 35%, #05060d 100%),
      linear-gradient(100deg, #1a2cd6 0%, #3a1aa8 55%, #6a1ab8 100%);
  }
  /* Velas tenues de fondo, como en las piezas originales */
  .mv-bloque::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.18;
    background-image:
      linear-gradient(90deg, transparent 46%, #9fb4ff 46%, #9fb4ff 54%, transparent 54%),
      linear-gradient(90deg, transparent 49%, #9fb4ff 49%, #9fb4ff 51%, transparent 51%);
    background-size:
      26px 46px,
      26px 80px;
    background-position:
      0 30%,
      0 25%;
    background-repeat: repeat-x;
    -webkit-mask-image: linear-gradient(180deg, #000 10%, transparent 60%);
    mask-image: linear-gradient(180deg, #000 10%, transparent 60%);
  }
  .mv-bloque h2 {
    font-size: clamp(2.2rem, 1.4rem + 2.4vw, 3.6rem);
    color: #22f1ff;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .mv-bloque p {
    margin: 0;
    max-width: 34em;
    font-size: var(--t-md);
    line-height: 1.5;
    color: #fff;
  }

  /* Cómo enseñamos */
  .ce {
    padding-block: clamp(3rem, 8vh, 5rem) clamp(2rem, 5vh, 3rem);
  }
  .ce h2 {
    font-size: var(--t-lg);
    margin-bottom: 1.5rem;
  }
  .ce h2 span {
    display: inline-block;
  }
  .ce-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem 2rem;
  }
  .ce-lista li {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--linea);
  }
  .ce-lista :global(svg) {
    width: 22px;
    height: 22px;
    color: var(--cian);
  }
  .ce-lista h3 {
    font-size: 1.1rem;
  }
  .ce-lista p {
    margin: 0;
    color: var(--bruma);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .qs-in,
    .mv-in {
      grid-template-columns: 1fr;
    }
    .ce-lista {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .ce-lista {
      grid-template-columns: 1fr;
    }
  }
</style>
