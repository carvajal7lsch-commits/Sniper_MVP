---
// Equipo completo a la vista y sin scroll: paneles en fila; el que se señala (mouse, teclado o toque)
// se expande y muestra rol y redes una por una. En celular, carrusel horizontal con todo visible.
import Icon from './Icon.astro';
import { contacto } from '../config/sitio';
import { nombreCompleto } from '../dominio/mentor';
import type { Mentor } from '../dominio/mentor';

interface Props {
  mentores: Mentor[];
}
const { mentores } = Astro.props;

type Enlace = { name: string; href: string; label: string };
const enlaces = (m: Mentor): Enlace[] => {
  const nombre = nombreCompleto(m);
  const lista: Enlace[] = [];
  if (m.redes.instagram) {
    lista.push({ name: 'instagram', href: m.redes.instagram, label: `Instagram de ${nombre}` });
  }
  if (m.redes.tiktok) {
    lista.push({ name: 'tiktok', href: m.redes.tiktok, label: `TikTok de ${nombre}` });
  }
  if (m.redes.youtube) {
    lista.push({ name: 'youtube', href: m.redes.youtube, label: `YouTube de ${nombre}` });
  }
  const texto = encodeURIComponent(`Hola, quiero información de las clases de ${nombre} en Sniper Pro.`);
  lista.push({
    name: 'whatsapp',
    href: `https://wa.me/${contacto.whatsappNumero}?text=${texto}`,
    label: `Preguntar por las clases de ${nombre}`,
  });
  return lista;
};
---

<ul class="eq" data-equipo>
  {mentores.map((m, i) => (
    <li
      class:list={['eq-panel', { activo: i === 0 }]}
      style={`--k:${i}`}
      id={m.slug}
      tabindex="0"
      aria-label={`${nombreCompleto(m)}, ${m.rol}`}
    >
      <img
        src={`/media/mentores/${m.slug}-400.webp`}
        srcset={`/media/mentores/${m.slug}-400.webp 400w, /media/mentores/${m.slug}-800.webp 800w`}
        sizes="(max-width: 760px) 75vw, 520px"
        width="400"
        height="500"
        alt=""
        loading="lazy"
        decoding="async"
      />
      <div class="eq-info">
        <h3 class="eq-nombre">
          <span class="first">{m.nombre}</span>
          {m.apellido && <span class="last">{m.apellido}</span>}
        </h3>
        <div class="eq-mas">
          <p class="eq-rol">
            <strong>{m.rol}</strong>
            <span>{m.enfoque}</span>
          </p>
          <div class="eq-acciones">
            <a class="eq-ver" href={`/mentores/${m.slug}/`}>
              Ver sus cursos
            </a>
            <ul class="eq-redes">
              {enlaces(m).map((r, n) => (
                <li style={`--d:${0.15 + n * 0.07}s`}>
                  <a href={r.href} target="_blank" rel="noopener" aria-label={r.label}>
                    <Icon name={r.name} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </li>
  ))}
</ul>

<script>
  // Con mouse se activa al pasar; con teclado al enfocar; con toque al tocar. Siempre hay uno abierto.
  document.querySelectorAll<HTMLElement>('[data-equipo]').forEach((equipo) => {
    const paneles = [...equipo.querySelectorAll<HTMLElement>('.eq-panel')];
    // Al cambiar de panel el ancho se reacomoda y el puntero quieto puede "entrar" a otro;
    // tras usar teclado o clic se ignora el hover un momento para no robarle el foco.
    let pausaHover = 0;
    const activar = (panel: HTMLElement) => {
      paneles.forEach((p) => p.classList.toggle('activo', p === panel));
    };
    const activarFijo = (panel: HTMLElement) => {
      pausaHover = performance.now() + 600;
      activar(panel);
    };
    paneles.forEach((panel) => {
      panel.addEventListener('pointerenter', (evento) => {
        if (evento.pointerType === 'mouse' && performance.now() > pausaHover) {
          activar(panel);
        }
      });
      panel.addEventListener('focusin', () => activarFijo(panel));
      panel.addEventListener('click', () => activarFijo(panel));
    });
  });
</script>

<style>
  .eq {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--eq-hueco, 0.75rem);
    height: var(--eq-alto, clamp(420px, 38vw, 520px));
  }
  .eq-panel {
    position: relative;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--r-md);
    background: #000;
    cursor: pointer;
    isolation: isolate;
    scroll-margin-top: 90px;
    transition:
      flex 0.55s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.35s;
  }
  .eq-panel.activo {
    flex: var(--eq-activo, 3.4);
    box-shadow:
      0 24px 50px -18px rgb(35 72 255 / 0.75),
      0 0 0 1.5px rgb(34 225 255 / 0.55);
  }
  .eq-panel img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition:
      transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 0.4s;
    filter: grayscale(0.55) brightness(0.75);
  }
  .eq-panel.activo img {
    filter: none;
    transform: scale(1.03);
  }
  .eq-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(0deg, rgb(5 6 13 / 0.95) 4%, rgb(5 6 13 / 0.45) 34%, transparent 60%);
    pointer-events: none;
  }
  .eq-panel:focus-visible {
    outline: 2px solid var(--cian);
    outline-offset: 3px;
  }

  .eq-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 1.1rem;
  }
  .eq-nombre {
    display: grid;
    line-height: 0.9;
    letter-spacing: 0;
    white-space: nowrap;
  }
  .first {
    font-size: clamp(1.1rem, 0.9rem + 0.7vw, 1.6rem);
    font-weight: 900;
    font-stretch: 125%;
    text-transform: uppercase;
    color: var(--cian);
  }
  .last {
    font-family: 'Allura', cursive;
    font-weight: 400;
    font-stretch: 100%;
    font-size: clamp(1.3rem, 1rem + 0.9vw, 1.9rem);
    color: #fff;
    margin: -0.12em 0 0 1.4em;
  }
  /* Panel cerrado: solo el nombre, en vertical para que quepa en lo angosto */
  .eq-panel:not(.activo) .eq-nombre {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    transform-origin: center;
  }
  .eq-panel:not(.activo) .last {
    display: none;
  }

  .eq-mas {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.7rem;
  }
  .eq-rol {
    margin: 0;
    display: grid;
    font-size: var(--t-sm);
    line-height: 1.35;
  }
  .eq-rol span {
    color: var(--bruma);
  }
  .eq-acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.9rem;
  }
  .eq-ver {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 1rem;
    border-radius: 999px;
    background: #fff;
    color: #05060d;
    font-weight: 700;
    font-size: 0.86rem;
    text-decoration: none;
  }
  .eq-ver:hover {
    background: var(--cian);
  }
  .eq-redes {
    display: flex;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .eq-redes a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    backdrop-filter: blur(6px);
    transition:
      background 0.2s,
      color 0.2s;
  }
  .eq-redes a:hover {
    background: var(--cian);
    color: var(--noche);
  }
  .eq-redes :global(svg) {
    width: 19px;
    height: 19px;
  }
  .eq-panel:not(.activo) .eq-mas {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .eq-panel.activo .eq-mas {
      animation: subir 0.35s ease-out 0.2s both;
    }
    .eq-panel.activo .eq-redes li {
      animation: subir 0.3s ease-out both;
      animation-delay: calc(0.25s + var(--d));
    }
  }
  @keyframes subir {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  /* Celular: carrusel horizontal, cada tarjeta con todo visible */
  @media (max-width: 760px) {
    .eq {
      height: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.75rem;
    }
    .eq-panel,
    .eq-panel.activo {
      flex: 0 0 72%;
      aspect-ratio: 4 / 5;
      scroll-snap-align: start;
      box-shadow: none;
    }
    .eq-panel img {
      filter: none;
    }
    .eq-panel:not(.activo) .eq-nombre {
      writing-mode: horizontal-tb;
      transform: none;
    }
    .eq-panel:not(.activo) .last,
    .eq-panel:not(.activo) .eq-mas {
      display: grid;
    }
  }
</style>
