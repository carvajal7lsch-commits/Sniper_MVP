---
// Hero de una sola idea: titular centrado y un botón sobre la clase real como fondo,
// con velas interactivas detrás. El video solo se descarga después de cargar la página.
import { links } from '../config/sitio';
import VelasFondo from './VelasFondo.astro';
import Icon from './Icon.astro';
---

<section class="hero" aria-labelledby="hero-titulo">
  <video
    class="hero-video"
    muted
    loop
    playsinline
    preload="none"
    poster="/media/clase-poster.webp"
    aria-label="Clase presencial de Sniper Pro con Miguel Monsalve"
    data-hero-video
  >
    <source data-src="/media/clase.webm" type="video/webm" />
    <source data-src="/media/clase.mp4" type="video/mp4" />
  </video>
  <div class="hero-velo" aria-hidden="true"></div>
  <VelasFondo />

  <div class="hero-copy">
    <h1 id="hero-titulo">
      <span class="frase">Más que una academia,</span> <span class="frase">una familia.</span>
    </h1>
    <p class="hero-sub">
      Sniper Pro es la academia de trading de Miguel Monsalve "La Máquina" y su equipo de mentores. Índices sintéticos y
      Forex, en vivo sobre el gráfico.
    </p>
    <a class="btn-blanco hero-cta" href={links.telegram} target="_blank" rel="noopener">
      Unirme gratis a la comunidad
    </a>
    <p class="hero-nota">Comunidad gratuita en Telegram. Sin tarjeta ni compromiso.</p>
  </div>

  <a class="hero-bajar" href="#fundador" aria-label="Bajar a conocer a Miguel y su equipo">
    <Icon name="chevron" />
  </a>
</section>

<script>
  // El video no compite con la carga inicial: entra después de "load" y nunca con ahorro de datos.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const reducir = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const conexion = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const ahorro = conexion?.saveData === true;
  const iniciar = () => {
    if (!video || reducir || ahorro) {
      return;
    }
    video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((fuente) => {
      fuente.src = fuente.dataset.src ?? '';
    });
    video.load();
    video.play().catch(() => {});
  };
  if (document.readyState === 'complete') {
    iniciar();
  } else {
    window.addEventListener('load', iniciar, { once: true });
  }
</script>

<style>
  /* Una sola escena a pantalla completa, como TradingView: el video de la clase va de fondo con un velo
     oscuro para leer el texto. Arriba queda una franja negra: el video no llega al encabezado. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-content: center;
    min-height: calc(100svh - 64px);
    padding: clamp(2rem, 6vh, 4rem) 0 clamp(4rem, 10vh, 7rem);
  }
  .hero-video {
    position: absolute;
    inset: 0;
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 16%, #000 84%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 16%, #000 84%, transparent 100%);
  }
  /* Borde inferior suave: el video y las velas se funden con la sección siguiente, sin corte */
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 14%;
    z-index: -1;
    background: linear-gradient(180deg, transparent, var(--noche));
    pointer-events: none;
  }
  .hero-velo {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(ellipse 60% 55% at 50% 45%, rgb(5 6 13 / 0.68), transparent 75%),
      linear-gradient(180deg, rgb(5 6 13 / 0.88) 0%, rgb(5 6 13 / 0.6) 40%, rgb(5 6 13 / 0.72) 72%, var(--noche) 100%);
  }
  .hero :global(.velas-fondo) {
    z-index: -1;
  }

  .hero-copy {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.4rem;
    width: min(100% - 2 * var(--gutter), 1180px);
    margin-inline: auto;
  }
  .hero-copy h1 {
    font-size: clamp(2.2rem, 1rem + 4.4vw, 4.4rem);
    letter-spacing: -0.035em;
    max-width: none;
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.5);
  }
  /* Cada parte de la frase se mantiene junta: corta después de la coma */
  .frase {
    display: inline-block;
  }
  .hero-sub {
    margin: 0;
    max-width: 40em;
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.3rem);
    color: #d6dbf2;
    line-height: 1.5;
  }
  .hero-cta {
    margin-top: 0.4rem;
    min-height: 54px;
    font-size: 1rem;
  }
  .hero-nota {
    margin: -0.6rem 0 0;
    font-size: 0.8rem;
    color: #9aa1c4;
  }

  /* Flecha para invitar a bajar: abajo al centro, con un leve rebote */
  .hero-bajar {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 3vh, 2rem);
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.22);
    background: rgb(5 6 13 / 0.35);
    color: var(--hueso);
    backdrop-filter: blur(6px);
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .hero-bajar:hover {
    border-color: var(--cian);
    background: rgb(34 241 255 / 0.12);
  }
  .hero-bajar :global(svg) {
    width: 22px;
    height: 22px;
  }
  /* En celular sube un poco para no quedar debajo del aviso de demo */
  @media (max-width: 700px) {
    .hero-bajar {
      bottom: 4.75rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-bajar :global(svg) {
      animation: rebote 1.8s ease-in-out infinite;
    }
  }
  @keyframes rebote {
    0%,
    100% {
      transform: translateY(-2px);
    }
    50% {
      transform: translateY(4px);
    }
  }

  /* Al bajar, el titular se desenfoca y se apaga mientras entra la siguiente sección (como TradingView).
     Solo donde el navegador soporta animaciones ligadas al scroll; en el resto queda quieto. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero {
        view-timeline: --hero block;
      }
      .hero-copy,
      .hero-bajar,
      .hero-video {
        animation: hero-salida linear both;
        animation-timeline: --hero;
        animation-range: exit 0% exit 75%;
      }
      .hero-video {
        animation-name: hero-video-salida;
      }
    }
  }
  @keyframes hero-salida {
    to {
      opacity: 0;
      filter: blur(14px);
      transform: translateY(-6vh) scale(0.97);
    }
  }
  @keyframes hero-video-salida {
    to {
      opacity: 0.25;
      filter: blur(10px);
    }
  }

  @media (max-width: 700px) {
    .hero {
      padding-bottom: 4rem;
    }
    .hero-video {
      object-position: 40% 30%;
    }
  }
</style>
