---
// Tarjeta de un curso: la portada que usa la academia arriba y los datos abajo. Toda la tarjeta
// lleva a la página del curso (/cursos/{slug}/), donde están las clases, las reseñas y el botón para
// inscribirse en la plataforma.
import { normalizar } from '../dominio/busqueda';
import type { Programa } from '../dominio/catalogo';
import { duracionTotal, formatoDuracion } from '../dominio/catalogo';
import type { Mentor } from '../dominio/mentor';
import { nombreCompleto } from '../dominio/mentor';

interface Props {
  programa: Programa;
  mentor: Mentor;
  categoria: string;
  // En el perfil del mentor no hace falta repetir quién lo dicta
  conMentor?: boolean;
  // Las primeras tarjetas de la página cargan la portada sin esperar
  prioridad?: boolean;
}
const { programa, mentor, categoria, conMentor = true, prioridad = false } = Astro.props;
const { actual, anteriores } = programa;
const clases = actual.clases.length || actual.lecciones;
const duracion = formatoDuracion(duracionTotal(actual));
const datos = [actual.nivel, clases === 1 ? '1 clase' : `${clases} clases`, duracion].filter(Boolean);
---

<li
  class="ct"
  data-mentor={mentor.slug}
  data-cat={actual.categoria}
  data-nivel={actual.nivel ?? ''}
  data-text={normalizar(
    `${actual.titulo} ${categoria} ${nombreCompleto(mentor)} ${actual.formato} ${actual.descripcion}`,
  )}
>
  <a class="ct-enlace" href={`/cursos/${actual.slug}/`}>
    <span class="ct-portada">
      <img
        src={`/media/cursos/${actual.id}-480.webp`}
        srcset={`/media/cursos/${actual.id}-480.webp 480w, /media/cursos/${actual.id}-960.webp 960w`}
        sizes="(max-width: 600px) 92vw, 320px"
        width="480"
        height="328"
        alt=""
        loading={prioridad ? 'eager' : 'lazy'}
        decoding="async"
      />
      {actual.edicion && <span class="ct-edicion">{actual.edicion}</span>}
      {actual.formato === 'Seminario' && <span class="ct-formato">Seminario</span>}
    </span>
    <span class="ct-cuerpo">
      <span class="ct-tema">{categoria}</span>
      <span class="ct-titulo">{actual.titulo}</span>
      {conMentor && (
        <span class="ct-mentor">
          <img src={`/media/mentores/${mentor.slug}-cara.webp`} alt="" width="24" height="24" loading="lazy" />
          {nombreCompleto(mentor)}
        </span>
      )}
      <span class="ct-datos">
        {datos.map((d) => (
          <span>{d}</span>
        ))}
      </span>
      {anteriores.length > 0 && (
        <span class="ct-antes">
          {anteriores.length === 1 ? '+1 edición anterior' : `+${anteriores.length} ediciones anteriores`}
        </span>
      )}
    </span>
  </a>
</li>

<style>
  .ct[hidden] {
    display: none;
  }
  .ct-enlace {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--r-md);
    background: #0d1226;
    border: 1px solid var(--linea);
    color: var(--hueso);
    text-decoration: none;
    transition:
      transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.25s,
      box-shadow 0.25s;
  }
  .ct-enlace:hover,
  .ct-enlace:focus-visible {
    transform: translateY(-4px);
    border-color: rgb(34 225 255 / 0.5);
    box-shadow: 0 20px 40px -18px rgb(35 72 255 / 0.7);
  }
  .ct-portada {
    position: relative;
    display: block;
    aspect-ratio: 480 / 328;
    overflow: hidden;
    background: #05060d;
  }
  .ct-portada img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .ct-enlace:hover .ct-portada img {
    transform: scale(1.04);
  }
  .ct-edicion,
  .ct-formato {
    position: absolute;
    top: 0.6rem;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 800;
    backdrop-filter: blur(6px);
  }
  .ct-edicion {
    right: 0.6rem;
    background: rgb(5 6 13 / 0.75);
    color: var(--cian);
  }
  .ct-formato {
    left: 0.6rem;
    background: rgb(255 255 255 / 0.9);
    color: #05060d;
  }
  .ct-cuerpo {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
    padding: 0.9rem 1rem 1rem;
  }
  .ct-tema {
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--cian);
  }
  .ct-titulo {
    font-size: 1.05rem;
    font-weight: 800;
    font-stretch: 112%;
    line-height: 1.25;
  }
  .ct-mentor {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: var(--bruma);
  }
  .ct-mentor img {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #000;
  }
  .ct-datos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.8rem;
    margin-top: auto;
    padding-top: 0.35rem;
    font-size: 0.8rem;
    color: #8d95bd;
  }
  .ct-antes {
    font-size: 0.74rem;
    color: #8d95bd;
  }
</style>
