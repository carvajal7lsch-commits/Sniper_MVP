---
// Reseñas reales con el aspecto de una notificación de Telegram (ícono, encabezado y "Nombre: texto"),
// en una franja que corre de derecha a izquierda. El encabezado no dice que vengan del grupo:
// son reseñas de la plataforma. Se detiene al pasar el cursor o al enfocarla; con "reducir movimiento"
// queda quieta y se desliza a mano.
import Icon from './Icon.astro';
import type { Resena } from '../dominio/resena';

interface Props {
  resenas: Resena[];
}
const { resenas } = Astro.props;
// La lista va dos veces para que el recorrido no tenga corte; la copia no la leen los lectores de pantalla.
const vueltas = [false, true];
---

<div class="carril" role="region" aria-label="Reseñas de estudiantes" tabindex="0">
  <p class="carril-nota">Reseñas de estudiantes en la plataforma</p>
  <div class="carril-pista">
    {vueltas.map((copia) => (
      <ul class="carril-lista" aria-hidden={copia ? 'true' : undefined}>
        {resenas.map((r) => (
          <li class="nt">
            <span class="nt-ico" aria-hidden="true">
              <Icon name="telegram" />
            </span>
            <div>
              <p class="nt-cabeza">
                <strong>Sniper Pro</strong>
                <span>reseña</span>
              </p>
              <p class="nt-msg">
                <strong>{r.nombre}:</strong> {r.texto}
              </p>
            </div>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .carril {
    position: relative;
    overflow: hidden;
    padding-top: 1.75rem;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }
  .carril:focus-visible {
    outline: 2px solid var(--cian);
    outline-offset: -2px;
  }
  .carril-nota {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    margin: 0;
    font-size: 0.78rem;
    color: #7f91a4;
    white-space: nowrap;
  }
  .carril-pista {
    display: flex;
    width: max-content;
  }
  .carril-lista {
    display: flex;
    align-items: center;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0 1rem 0 0;
  }
  /* Notificación de Telegram */
  .nt {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 0.65rem;
    width: 340px;
    padding: 0.7rem 0.85rem;
    border-radius: 16px;
    background: rgb(23 33 43 / 0.94);
    border: 1px solid rgb(255 255 255 / 0.08);
    box-shadow: 0 18px 40px -14px rgb(0 0 0 / 0.8);
  }
  .nt-ico {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(180deg, #37bbfe, #007dbb);
    color: #fff;
  }
  .nt-ico :global(svg) {
    width: 20px;
    height: 20px;
  }
  .nt-cabeza {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0 0 0.15rem;
    font-size: 0.82rem;
  }
  .nt-cabeza span {
    color: #7f91a4;
    font-size: 0.74rem;
  }
  .nt-msg {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.4;
    color: #dbe4ee;
  }
  .nt-msg strong {
    color: #6ec9ff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .carril-pista {
      animation: correr 110s linear infinite;
    }
    .carril:hover .carril-pista,
    .carril:focus-within .carril-pista {
      animation-play-state: paused;
    }
  }
  @keyframes correr {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .carril {
      overflow-x: auto;
    }
    .carril-lista[aria-hidden] {
      display: none;
    }
  }
</style>
