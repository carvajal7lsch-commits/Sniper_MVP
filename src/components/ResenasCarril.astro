---
// Reseñas reales en una franja que corre de derecha a izquierda, como en el sitio original.
// Se detiene al pasar el cursor o al enfocar una tarjeta; con "reducir movimiento" queda quieta
// y se recorre deslizando.
import type { Resena } from '../dominio/resena';

interface Props {
  resenas: Resena[];
}
const { resenas } = Astro.props;
const colores = ['#6ec9ff', '#ffb86b', '#b9a6ff', '#7ee3a2', '#ff8fa3', '#f5d76e'];
const colorDe = (nombre: string) => colores[[...nombre].reduce((a, c) => a + c.charCodeAt(0), 0) % colores.length];
// La lista va dos veces para que el recorrido no tenga corte; la copia no la leen los lectores de pantalla.
const vueltas = [false, true];
---

<div class="carril" role="region" aria-label="Reseñas de estudiantes" tabindex="0">
  <div class="carril-pista">
    {vueltas.map((copia) => (
      <ul class="carril-lista" aria-hidden={copia ? 'true' : undefined}>
        {resenas.map((r) => (
          <li class="rs">
            <p class="rs-cabeza">
              <span class="rs-av" style={`--c:${colorDe(r.nombre)}`} aria-hidden="true">
                {r.nombre.charAt(0)}
              </span>
              <strong>{r.nombre}</strong>
              <span class="rs-insignia">Estudiante</span>
            </p>
            <p class="rs-texto">{r.texto}</p>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .carril {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .carril:focus-visible {
    outline: 2px solid var(--cian);
    outline-offset: 4px;
  }
  .carril-pista {
    display: flex;
    width: max-content;
  }
  .carril-lista {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0 0.75rem 0 0;
  }
  .rs {
    width: 300px;
    padding: 0.75rem 0.95rem 0.8rem;
    border-radius: 14px;
    background: #10162c;
    border: 1px solid var(--linea);
  }
  .rs-cabeza {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
    font-size: 0.85rem;
  }
  .rs-av {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--c);
    color: #0b1020;
    font-weight: 800;
    font-size: 0.8rem;
  }
  .rs-insignia {
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    background: rgb(34 241 255 / 0.12);
    color: var(--cian);
    font-size: 0.68rem;
    font-weight: 700;
  }
  .rs-texto {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.45;
    color: #d7dcf0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .carril-pista {
      animation: correr 90s linear infinite;
    }
    .carril:hover .carril-pista,
    .carril:focus-within .carril-pista {
      animation-play-state: paused;
    }
  }
  @keyframes correr {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .carril {
      overflow-x: auto;
    }
    .carril-lista[aria-hidden] {
      display: none;
    }
  }
</style>
