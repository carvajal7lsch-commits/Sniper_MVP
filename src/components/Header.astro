---
// Encabezado inspirado en la sobriedad de TradingView: transparente sobre el hero,
// toma fondo al bajar, enlaces de texto y un único botón. Cursos abre un panel flotante.
import { nav, links } from '../config/sitio';
import type { Categoria, Curso } from '../dominio/curso';
import type { Mentor } from '../dominio/mentor';
import { crearIndiceBusqueda } from '../dominio/busqueda';
import { agruparEdiciones, resumirMentor } from '../dominio/catalogo';
import Buscador from './Buscador.astro';
import Icon from './Icon.astro';

interface Props {
  categorias: Categoria[];
  cursos: Curso[];
  mentores: Mentor[];
}
const { categorias, cursos, mentores } = Astro.props;
const path = Astro.url.pathname;
const esActiva = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const vigentes = agruparEdiciones(cursos).map((p) => p.actual);
const conteo = (id: string) => vigentes.filter((c) => c.categoria === id).length;
const deMentor = (slug: string) => resumirMentor(cursos.filter((c) => c.mentor === slug)).cursos;
const inicio = nav.find((n) => n.href === '/');
const otros = nav.filter((n) => n.href !== '/' && n.href !== '/cursos/');
const paginas = [
  { titulo: 'Inicio', detalle: 'Sniper Pro Academy', href: '/' },
  { titulo: 'Cursos', detalle: 'Catálogo por mentor, tema y nivel', href: '/cursos/' },
  { titulo: 'Mentores', detalle: 'El equipo de la academia', href: '/mentores/' },
  { titulo: 'Nosotros', detalle: 'Qué es Sniper Pro y los presenciales', href: '/nosotros/' },
  { titulo: 'Contacto', detalle: 'WhatsApp, Telegram y correo', href: '/contacto/' },
  { titulo: 'Comunidad en Telegram', detalle: 'Gratis: análisis y avisos de clases', href: links.telegram },
];
const indice = crearIndiceBusqueda(cursos, categorias, mentores, paginas);
---

<header class="hd" data-hd>
  <div class="hd-in">
    <button
      class="hd-burger"
      type="button"
      aria-label="Menú"
      aria-expanded="false"
      aria-controls="menu-movil"
      data-abrir-menu
    >
      <Icon name="menu" />
      <Icon name="close" />
    </button>

    <a href="/" class="hd-logo" aria-label="Sniper Pro, inicio">
      <img src="/media/logo.webp" alt="Sniper Pro Trading" width="152" height="44" />
    </a>

    <nav class="hd-nav" aria-label="Principal">
      <ul>
        {inicio && (
          <li>
            <a href={inicio.href} class="hd-link" aria-current={esActiva(inicio.href) ? 'page' : undefined}>
              {inicio.label}
            </a>
          </li>
        )}
        <li class="dd">
          <a href="/cursos/" class="hd-link" aria-current={esActiva('/cursos/') ? 'page' : undefined}>
            Cursos
          </a>
          <button
            class="dd-btn"
            type="button"
            aria-expanded="false"
            aria-controls="panel-cursos"
            aria-label="Menú de cursos"
          >
            <Icon name="chevron" />
          </button>
          <div class="dd-panel" id="panel-cursos">
            <div class="dd-col">
              <p class="dd-lbl">Por mentor</p>
              <ul class="dd-mentores">
                {mentores.map((m) => (
                  <li>
                    <a href={`/cursos/?mentor=${m.slug}`}>
                      <img src={`/media/mentores/${m.slug}-cara.webp`} alt="" width="32" height="32" loading="lazy" />
                      <span>
                        {m.nombre} {m.apellido}
                      </span>
                      <span class="dd-num">{deMentor(m.slug)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <div class="dd-col">
              <p class="dd-lbl">Por tema</p>
              <ul class="dd-list">
                {categorias.map((c) => (
                  <li>
                    <a href={`/cursos/?tema=${c.id}`}>
                      <span>{c.nombre}</span>
                      <span class="dd-num">{conteo(c.id)}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <a class="dd-todos" href="/cursos/">
                Ver todos los cursos
              </a>
            </div>
          </div>
        </li>
        {otros.map((n) => (
          <li>
            <a href={n.href} class="hd-link" aria-current={esActiva(n.href) ? 'page' : undefined}>
              {n.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hd-actions">
      <Buscador indice={indice} />
      <a class="hd-login" href="/ingresar/">
        Ingresar
      </a>
      <a class="btn-blanco" href={links.telegram} target="_blank" rel="noopener">
        Únete gratis
      </a>
    </div>
  </div>
</header>

<dialog class="mm" id="menu-movil" data-menu-movil aria-label="Menú">
  <nav aria-label="Principal en celular">
    <ul class="mm-list">
      {nav.map((n) => (
        <li>
          <a href={n.href} aria-current={esActiva(n.href) ? 'page' : undefined}>
            {n.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="mm-pie">
    <a class="mm-sec" href="/ingresar/">
      <Icon name="usuario" />
      Ingresar
    </a>
    <a class="mm-sec" href={links.whatsapp} target="_blank" rel="noopener">
      <Icon name="whatsapp" />
      WhatsApp
    </a>
  </div>
</dialog>

<script>
  const encabezado = document.querySelector<HTMLElement>('[data-hd]');
  const marcarFondo = () => encabezado?.classList.toggle('con-fondo', window.scrollY > 8);
  marcarFondo();
  window.addEventListener('scroll', marcarFondo, { passive: true });

  // Menú de celular: una tarjeta pequeña bajo el botón, no una pantalla completa.
  const menu = document.querySelector<HTMLDialogElement>('[data-menu-movil]');
  const burger = document.querySelector<HTMLButtonElement>('[data-abrir-menu]');
  const cerrarMenu = () => {
    menu?.close();
    burger?.setAttribute('aria-expanded', 'false');
  };
  burger?.addEventListener('click', (evento) => {
    evento.stopPropagation();
    if (menu?.open) {
      cerrarMenu();
    } else {
      menu?.show();
      burger.setAttribute('aria-expanded', 'true');
    }
  });
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', cerrarMenu));
  document.addEventListener('click', (evento) => {
    if (menu?.open && !menu.contains(evento.target as Node)) cerrarMenu();
  });
  document.addEventListener('keydown', (evento) => {
    if (evento.key === 'Escape' && menu?.open) {
      cerrarMenu();
      burger?.focus();
    }
  });
  window.addEventListener('scroll', () => menu?.open && cerrarMenu(), { passive: true });

  // El panel abre con el mouse por CSS; este botón lo abre con clic, toque o teclado.
  document.querySelectorAll<HTMLButtonElement>('.dd-btn').forEach((boton) => {
    const item = boton.closest('.dd');
    boton.addEventListener('click', () => {
      const abierto = boton.getAttribute('aria-expanded') === 'true';
      boton.setAttribute('aria-expanded', String(!abierto));
      item?.classList.toggle('abierto', !abierto);
    });
    item?.addEventListener('keydown', (evento) => {
      if ((evento as KeyboardEvent).key === 'Escape') {
        boton.setAttribute('aria-expanded', 'false');
        item.classList.remove('abierto');
        boton.focus();
      }
    });
  });
  // Tras elegir una opción el panel se cierra aunque el mouse siga encima.
  document.querySelectorAll<HTMLElement>('.dd').forEach((item) => {
    item.querySelectorAll('.dd-panel a').forEach((a) =>
      a.addEventListener('click', () => {
        item.classList.add('pausa');
        item.classList.remove('abierto');
        item.querySelector('.dd-btn')?.setAttribute('aria-expanded', 'false');
        (document.activeElement as HTMLElement | null)?.blur();
      }),
    );
    item.addEventListener('mouseleave', () => item.classList.remove('pausa'));
  });
  document.addEventListener('click', (evento) => {
    document.querySelectorAll('.dd.abierto').forEach((item) => {
      if (!item.contains(evento.target as Node)) {
        item.classList.remove('abierto');
        item.querySelector('.dd-btn')?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: 50;
    transition:
      background 0.25s,
      box-shadow 0.25s;
  }
  .hd.con-fondo {
    background: rgb(5 6 13 / 0.82);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.06);
  }
  .hd-in {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 64px;
    padding-inline: clamp(1rem, 3vw, 2rem);
    max-width: 1440px;
    margin-inline: auto;
  }
  .hd-logo img {
    height: 46px;
    width: auto;
  }

  .hd-nav {
    flex: 1;
  }
  .hd-nav > ul {
    display: flex;
    justify-content: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hd-link {
    display: block;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
    transition: background 0.15s;
  }
  .hd-link:hover,
  .dd:hover > .hd-link,
  .dd.abierto > .hd-link {
    background: rgb(255 255 255 / 0.1);
  }
  .hd-link[aria-current='page'] {
    color: var(--cian);
  }

  /* Panel flotante de cursos */
  .dd {
    position: relative;
    display: flex;
    align-items: center;
  }
  .dd-btn {
    width: 22px;
    height: 22px;
    margin-left: -0.55rem;
    display: grid;
    place-items: center;
    border: 0;
    background: none;
    color: rgb(255 255 255 / 0.6);
    border-radius: 50%;
    cursor: pointer;
  }
  .dd-btn :global(svg) {
    width: 14px;
    height: 14px;
    transition: transform 0.2s;
  }
  .dd.abierto .dd-btn :global(svg) {
    transform: rotate(180deg);
  }
  .dd-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: -0.5rem;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 0.25rem;
    width: 560px;
    padding: 0.5rem;
    background: #141722;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 14px;
    box-shadow: 0 24px 60px -12px rgb(0 0 0 / 0.7);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 0.18s,
      transform 0.18s,
      visibility 0.18s;
  }
  .dd-panel::before {
    content: '';
    position: absolute;
    inset: -12px 0 auto;
    height: 12px;
  }
  @media (hover: hover) {
    .dd:hover .dd-panel {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }
  .dd.abierto .dd-panel {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .dd.pausa .dd-panel {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
  }

  .dd-todos {
    display: block;
    margin: 0.5rem 0.6rem 0.4rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--cian);
    text-decoration: none;
  }
  .dd-todos:hover {
    text-decoration: underline;
  }
  .dd-mentores {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .dd-mentores a {
    display: grid;
    grid-template-columns: 32px 1fr auto;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.6rem;
    border-radius: 8px;
    color: var(--hueso);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .dd-mentores a:hover {
    background: rgb(255 255 255 / 0.06);
  }
  .dd-mentores img {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 15%;
    background: #000;
  }
  .dd-lbl {
    margin: 0.85rem 0.7rem 0.3rem;
    font-size: 0.75rem;
    color: #6f7699;
  }
  .dd-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .dd-list a {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.92rem;
  }
  .dd-list a:hover {
    background: rgb(255 255 255 / 0.07);
  }
  .dd-num {
    color: #6f7699;
    font-size: 0.82rem;
  }

  .hd-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .hd-login {
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }
  .hd-login:hover {
    color: var(--cian);
  }

  .hd-burger {
    display: none;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 0;
    background: none;
    color: #fff;
    cursor: pointer;
    margin-left: -0.5rem;
  }
  .hd-burger :global(svg) {
    width: 24px;
    height: 24px;
  }

  .hd-burger :global(svg:last-child),
  .hd-burger[aria-expanded='true'] :global(svg:first-child) {
    display: none;
  }
  .hd-burger[aria-expanded='true'] :global(svg:last-child) {
    display: block;
  }

  /* Menú en celular: tarjeta compacta bajo el botón */
  .mm {
    position: fixed;
    inset: 60px auto auto 0.75rem;
    z-index: 60;
    width: min(232px, calc(100vw - 1.5rem));
    margin: 0;
    padding: 0.4rem;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 14px;
    background: #141722;
    color: var(--hueso);
    box-shadow: 0 24px 60px -12px rgb(0 0 0 / 0.75);
  }
  .mm[open] {
    animation: mm-abrir 0.16s ease-out;
  }
  @keyframes mm-abrir {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .mm-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mm-list a {
    display: block;
    padding: 0.62rem 0.75rem;
    border-radius: 9px;
    font-size: 0.98rem;
    font-weight: 600;
    text-decoration: none;
  }
  .mm-list a:hover,
  .mm-list a:focus-visible {
    background: rgb(255 255 255 / 0.06);
  }
  .mm-list a[aria-current='page'] {
    color: var(--cian);
  }
  .mm-pie {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.3rem;
    padding-top: 0.3rem;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }
  .mm-sec {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.75rem;
    border-radius: 9px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--bruma);
    text-decoration: none;
  }
  .mm-sec:hover {
    background: rgb(255 255 255 / 0.06);
    color: var(--hueso);
  }
  .mm-sec :global(svg) {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 960px) {
    .hd-nav,
    .hd-login {
      display: none;
    }
    .hd-actions {
      margin-left: auto;
      gap: 0.5rem;
    }
    .hd-logo img {
      height: 38px;
    }
    .hd-in {
      gap: 0.5rem;
    }
    .hd-burger {
      display: grid;
    }

    .hd-actions .btn-blanco {
      min-height: 38px;
      padding-inline: 1rem 1.3rem;
      font-size: 0.85rem;
    }
  }
</style>
