---
// Pie de página. El borde de arriba es una línea de precio: el pie "sube" como un gráfico y el
// último punto late, como el precio en vivo. Columnas al estilo de TradingView.
import { links, contacto } from '../config/sitio';
import { repositorios } from '../infraestructura/contenedor';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const categorias = await repositorios.cursos.listarCategorias();
const redes = [
  { name: 'instagram', href: links.instagram, label: 'Instagram' },
  { name: 'youtube', href: links.youtube, label: 'YouTube' },
  { name: 'facebook', href: links.facebook, label: 'Facebook' },
  { name: 'telegram', href: links.telegram, label: 'Telegram' },
  { name: 'whatsapp', href: links.whatsapp, label: 'WhatsApp' },
];
const columnas = [
  {
    titulo: 'Academia',
    enlaces: [
      { t: 'Inicio', href: '/' },
      { t: 'Nosotros', href: '/nosotros/' },
      { t: 'Mentores', href: '/mentores/' },
      { t: 'Contacto', href: '/contacto/' },
      { t: 'Ingresar', href: '/ingresar/' },
    ],
  },
  {
    titulo: 'Cursos',
    enlaces: [
      ...categorias.map((c) => ({ t: c.nombre, href: `/cursos/?tema=${c.id}` })),
      { t: 'Todos los cursos', href: '/cursos/' },
    ],
  },
  {
    titulo: 'Comunidad y app',
    enlaces: [
      { t: 'Telegram gratis', href: links.telegram, fuera: true },
      { t: 'App para Android', href: links.googlePlay, fuera: true },
      { t: 'App para iPhone (TestFlight)', href: links.testflight, fuera: true },
      { t: 'Cuenta en Weltrade', href: links.weltrade, fuera: true },
    ],
  },
];

// Línea de precio del borde superior (viewBox 1440 × 120).
const puntos: [number, number][] = [
  [0, 96],
  [70, 84],
  [120, 92],
  [190, 70],
  [250, 78],
  [320, 58],
  [380, 66],
  [430, 50],
  [480, 74],
  [540, 62],
  [610, 80],
  [680, 64],
  [740, 70],
  [800, 46],
  [860, 54],
  [930, 38],
  [990, 48],
  [1060, 30],
  [1120, 42],
  [1190, 26],
  [1250, 34],
  [1320, 16],
  [1380, 24],
  [1440, 10],
];
const linea = puntos.map(([x, y]) => `${x},${y}`).join(' ');
// Lo que queda por encima de la línea se pinta del color de la página: así el fondo del pie (con su
// cuadrícula y su brillo) sigue sin cortes bajo la línea.
const area = `M0,0 L1440,0 L${[...puntos]
  .reverse()
  .map(([x, y]) => `${x},${y}`)
  .join(' L')} Z`;
const [ux, uy] = puntos[puntos.length - 2];
---

<footer class="ft">
  <div class="ft-borde" aria-hidden="true">
    <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
      <path d={area}></path>
      <polyline points={linea}></polyline>
    </svg>
    <span class="ft-precio" style={`left:${(ux / 1440) * 100}%;top:${(uy / 120) * 100}%`}></span>
  </div>

  <div class="ft-cuerpo">
    <div class="wrap ft-grid">
      <div class="ft-brand">
        <img src="/media/logo.webp" alt="Sniper Pro Trading" width="152" height="44" loading="lazy" />
        <p>
          Academia de trading en Cúcuta para toda Latinoamérica. <span>Más que una academia, una familia.</span>
        </p>
        <ul class="ft-social" aria-label="Redes sociales">
          {redes.map((r) => (
            <li>
              <a href={r.href} target="_blank" rel="noopener" aria-label={r.label}>
                <Icon name={r.name} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      {columnas.map((c) => (
        <nav aria-label={c.titulo}>
          <h2 class="ft-h">{c.titulo}</h2>
          <ul class="ft-list">
            {c.enlaces.map((e) => (
              <li>
                <a href={e.href} {...('fuera' in e ? { target: '_blank', rel: 'noopener' } : {})}>
                  {e.t}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}

      <div class="ft-contacto">
        <h2 class="ft-h">Contacto</h2>
        <ul class="ft-list">
          <li>
            <a href={links.whatsapp} target="_blank" rel="noopener">
              WhatsApp
            </a>
          </li>
          <li>
            <a href={contacto.telefonoHref}>{contacto.telefono}</a>
          </li>
          <li>
            <a href={`mailto:${contacto.email}`}>{contacto.email}</a>
          </li>
          <li>{contacto.ciudad}</li>
        </ul>
      </div>
    </div>

    <div class="wrap ft-legal">
      <p>
        <strong>Aviso de riesgo.</strong> Operar índices sintéticos, Forex y otros instrumentos apalancados implica un
        riesgo alto de pérdida y puede no ser adecuado para todas las personas. Los resultados pasados no garantizan
        resultados futuros. El contenido de Sniper Pro es educativo y no constituye asesoría financiera personalizada.
      </p>
      <div class="ft-fin">
        <p>© {year} Sniper Pro Trading. Todos los derechos reservados.</p>
        <p>Demo de rediseño propuesta para Sniper Pro; no es el sitio oficial.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .ft {
    --ft-bg: #080c22;
    position: relative;
    isolation: isolate;
    font-size: var(--t-sm);
    background:
      radial-gradient(ellipse 55% 60% at 88% 4%, rgb(35 72 255 / 0.25), transparent 70%),
      linear-gradient(var(--ft-bg) 20%, #04050c 90%);
  }
  /* Cuadrícula de gráfico que se desvanece hacia abajo */
  .ft::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px) 0 0 / 100% 64px,
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px) 0 0 / 96px 100%;
    -webkit-mask: linear-gradient(#000, transparent 55%);
    mask: linear-gradient(#000, transparent 55%);
    pointer-events: none;
  }

  /* Borde: el área bajo la línea es el propio pie */
  .ft-borde {
    position: relative;
    height: clamp(56px, 8vw, 120px);
  }
  .ft-borde svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .ft-borde path {
    fill: var(--noche);
  }
  .ft-borde polyline {
    fill: none;
    stroke: var(--cian);
    stroke-width: 1.6;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 6px rgb(34 225 255 / 0.55));
  }
  .ft-precio {
    position: absolute;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: var(--cian);
    box-shadow: 0 0 0 0 rgb(34 225 255 / 0.6);
    animation: latir 2s ease-out infinite;
  }
  @keyframes latir {
    70% {
      box-shadow: 0 0 0 12px rgb(34 225 255 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(34 225 255 / 0);
    }
  }

  .ft-cuerpo {
    padding-top: clamp(1rem, 3vw, 2.5rem);
  }
  .ft-grid {
    position: relative;
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: 1.5fr repeat(4, minmax(0, 1fr));
  }
  .ft-brand img {
    height: 40px;
    width: auto;
    margin-bottom: 1rem;
  }
  .ft-brand p {
    max-width: 30ch;
    margin: 0;
    color: var(--bruma);
  }
  .ft-brand p span {
    display: block;
    margin-top: 0.35rem;
    color: var(--hueso);
  }
  .ft-h {
    font-size: var(--t-sm);
    font-stretch: 112%;
    letter-spacing: 0;
    margin: 0 0 1rem;
  }
  .ft-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    color: var(--bruma);
  }
  .ft-list a {
    text-decoration: none;
    color: var(--bruma);
  }
  .ft-list a:hover {
    color: var(--hueso);
    text-decoration: underline;
  }
  .ft-social {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
  }
  .ft-social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.06);
    color: var(--bruma);
    transition:
      background 0.2s,
      color 0.2s;
  }
  .ft-social a:hover {
    background: var(--azul);
    color: #fff;
  }
  .ft-social :global(svg) {
    width: 19px;
    height: 19px;
  }
  .ft-legal {
    position: relative;
    margin-top: 3rem;
    padding-block: 1.75rem 4.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.07);
    color: #6f79a6;
    font-size: var(--t-xs);
    display: grid;
    gap: 1rem;
  }
  .ft-legal p {
    margin: 0;
    max-width: 100ch;
  }
  .ft-legal strong {
    color: var(--bruma);
  }
  .ft-fin {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }

  @media (max-width: 1000px) {
    .ft-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ft-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .ft-contacto,
    .ft-grid > nav:nth-of-type(3) {
      grid-column: 1 / -1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ft-precio {
      animation: none;
    }
  }
</style>
