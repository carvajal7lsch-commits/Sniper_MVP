---
// Comunidad gratuita: a la izquierda la invitación, a la derecha la pieza real de la academia
// (captura del grupo de Telegram con los íconos 3D). Sobre ella, una notificación de Telegram
// va mostrando reseñas reales de estudiantes, una a la vez.
import Icon from './Icon.astro';
import { links } from '../config/sitio';
import type { Resena } from '../dominio/resena';

interface Props {
  resenas: Resena[];
}
const { resenas } = Astro.props;
// Reseñas cortas: caben en la notificación sin cortarse a mitad de idea.
const avisos = resenas.filter((r) => r.texto.length <= 150).slice(0, 8);
---

<section class="com" aria-labelledby="com-titulo">
  <div class="wrap com-in">
    <div class="com-texto" data-revelar>
      <h2 id="com-titulo">Únete a nuestra comunidad free</h2>
      <p class="com-lead">Recibe información de primera mano y mantente al tanto de nuestra labor.</p>
      <ul class="com-lista">
        <li>
          <Icon name="mira" />
          Análisis del mercado
        </li>
        <li>
          <Icon name="mira" />
          Avisos de clases en vivo
        </li>
        <li>
          <Icon name="mira" />
          Fechas de los presenciales
        </li>
      </ul>
      <div class="com-accion">
        <a class="btn-blanco" href={links.telegram} target="_blank" rel="noopener">
          <Icon name="telegram" />
          Unirme al Telegram
        </a>
        <p class="com-nota">Gratis. Sin tarjeta ni compromiso.</p>
      </div>
    </div>

    <figure class="com-escena">
      <picture>
        <source media="(max-width: 700px)" srcset="/media/comunidad-tg-450.webp" />
        <img
          class="com-cel"
          src="/media/comunidad-tg-900.webp"
          width="900"
          height="1048"
          alt="Grupo de Telegram de la comunidad Sniper Pro en un celular"
          loading="lazy"
          decoding="async"
        />
      </picture>

      <div class="aviso" data-avisos aria-live="polite">
        <span class="aviso-ico" aria-hidden="true">
          <Icon name="telegram" />
        </span>
        <div class="aviso-txt">
          <p class="aviso-cabeza">
            <strong>Comunidad Sniper Pro</strong>
            <span>ahora</span>
          </p>
          {avisos.map((r, i) => (
            <p class="aviso-msg" data-aviso hidden={i > 0 ? true : undefined}>
              <strong>{r.nombre}:</strong> {r.texto}
            </p>
          ))}
        </div>
      </div>
      <figcaption class="sr-only">Reseñas reales de estudiantes, mostradas como notificación.</figcaption>
    </figure>
  </div>
</section>

<script>
  // Rota las reseñas cada pocos segundos solo mientras la sección está en pantalla.
  const aviso = document.querySelector<HTMLElement>('[data-avisos]');
  const mensajes = aviso ? [...aviso.querySelectorAll<HTMLElement>('[data-aviso]')] : [];
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (aviso && mensajes.length > 1 && !quieto) {
    let actual = 0;
    let reloj = 0;
    const siguiente = () => {
      aviso.classList.add('saliendo');
      window.setTimeout(() => {
        mensajes[actual].hidden = true;
        actual = (actual + 1) % mensajes.length;
        mensajes[actual].hidden = false;
        aviso.classList.remove('saliendo');
      }, 350);
    };
    new IntersectionObserver(([e]) => {
      window.clearInterval(reloj);
      if (e.isIntersecting) {
        reloj = window.setInterval(siguiente, 4500);
      }
    }).observe(aviso);
  }
</script>

<style>
  .com {
    padding-block: clamp(3rem, 8vh, 5rem);
    overflow: hidden;
  }
  .com-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  .com-texto {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .com-texto h2 {
    font-size: clamp(2rem, 1.1rem + 2.4vw, 3.3rem);
    color: #19e6f2;
    max-width: 12ch;
  }
  .com-lead {
    margin: 0;
    color: var(--bruma);
    max-width: 30em;
  }
  .com-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .com-lista li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .com-lista :global(svg) {
    width: 16px;
    height: 16px;
    color: var(--cian);
  }
  .com-accion {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.1rem;
    margin-top: 0.4rem;
  }
  .com-nota {
    margin: 0;
    font-size: 0.8rem;
    color: var(--bruma);
  }

  .com-escena {
    position: relative;
    margin: 0;
    justify-self: center;
  }
  /* La pieza original trae fondo negro con un degradado azul abajo: se funde con la página por los bordes */
  .com-cel {
    display: block;
    width: auto;
    height: min(560px, calc(100svh - 64px - 7rem));
    max-width: 100%;
    object-fit: contain;
    -webkit-mask-image: radial-gradient(ellipse 62% 58% at 50% 50%, #000 60%, transparent 100%);
    mask-image: radial-gradient(ellipse 62% 58% at 50% 50%, #000 60%, transparent 100%);
  }

  /* Notificación de Telegram con una reseña real */
  .aviso {
    position: absolute;
    left: -4%;
    bottom: 10%;
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 0.65rem;
    width: min(340px, 92%);
    padding: 0.7rem 0.85rem;
    border-radius: 16px;
    background: rgb(23 33 43 / 0.92);
    border: 1px solid rgb(255 255 255 / 0.08);
    box-shadow: 0 18px 40px -14px rgb(0 0 0 / 0.8);
    backdrop-filter: blur(10px);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }
  .aviso.saliendo {
    opacity: 0;
    transform: translateY(8px);
  }
  .aviso-ico {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(180deg, #37bbfe, #007dbb);
    color: #fff;
  }
  .aviso-ico :global(svg) {
    width: 20px;
    height: 20px;
  }
  .aviso-cabeza {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0 0 0.15rem;
    font-size: 0.8rem;
  }
  .aviso-cabeza span {
    color: #7f91a4;
    font-size: 0.72rem;
  }
  .aviso-msg {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.4;
    color: #dbe4ee;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .aviso-msg[hidden] {
    display: none;
  }
  .aviso-msg strong {
    color: #6ec9ff;
  }

  @media (max-width: 860px) {
    .com-in {
      grid-template-columns: 1fr;
    }
    .com-cel {
      height: auto;
      width: min(380px, 100%);
    }
    .aviso {
      left: 0;
      bottom: 6%;
    }
  }
</style>
