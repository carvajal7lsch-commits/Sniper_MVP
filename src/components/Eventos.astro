---
// Cierre de la página, recreado a partir de la sección original de la academia:
// foto nocturna de la ciudad de fondo, titular en cian y los accesos a sus redes en color.
import { links } from '../config/sitio';
import Icon from './Icon.astro';

// Los íconos de redes son los PNG originales de la academia; Telegram no está en su fila y va dibujado.
const redes = [
  { nombre: 'Instagram', imagen: 'red-instagram', href: links.instagram },
  { nombre: 'WhatsApp', imagen: 'red-whatsapp', href: links.whatsapp },
  { nombre: 'Facebook', imagen: 'red-facebook', href: links.facebook },
  { nombre: 'YouTube', imagen: 'red-youtube', href: links.youtube },
];
---

<section class="ev" aria-labelledby="ev-titulo">
  <picture>
    <source media="(max-width: 700px)" srcset="/media/eventos-800.webp" />
    <img
      class="ev-fondo"
      src="/media/eventos-1600.webp"
      width="1600"
      height="900"
      alt=""
      loading="lazy"
      decoding="async"
    />
  </picture>

  <div class="wrap ev-in" data-revelar>
    <p class="ev-pastilla">Sniper Pro</p>
    <h2 id="ev-titulo">Próximos eventos</h2>
    <p class="ev-sub">Presenciales Sniper Pro, más cerca de tu comunidad.</p>
    <p class="ev-nota">Las fechas y ciudades se anuncian primero en el Telegram y en las redes.</p>

    <ul class="ev-redes" aria-label="Redes de Sniper Pro">
      <li>
        <a
          class="app-ico wt"
          href={links.weltrade}
          target="_blank"
          rel="noopener"
          aria-label="Abrir cuenta en Weltrade, el broker de la academia"
        >
          <img src="/media/weltrade.webp" alt="" width="96" height="96" loading="lazy" />
        </a>
      </li>
      {redes.map((r) => (
        <li>
          <a class="app-ico" href={r.href} target="_blank" rel="noopener" aria-label={r.nombre}>
            <img src={`/media/${r.imagen}.webp`} alt="" width="96" height="96" loading="lazy" />
          </a>
        </li>
      ))}
      <li>
        <a class="app-ico tg" href={links.telegram} target="_blank" rel="noopener" aria-label="Telegram">
          <Icon name="telegram" />
        </a>
      </li>
    </ul>
    <p class="ev-siguenos">Síguenos</p>
  </div>
</section>

<style>
  .ev {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(2rem, 5vh, 3.5rem) clamp(3rem, 7vh, 4.5rem);
  }
  .ev picture {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .ev-fondo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 80%;
    filter: grayscale(1) brightness(0.85) contrast(1.1);
  }
  /* Oscuro y con un tinte azul que continúa el de "App señales": arriba nace del fondo de la página */
  .ev::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, var(--noche) 0%, rgb(5 8 32 / 0.6) 30%, rgb(5 8 32 / 0.25) 65%, var(--noche) 100%),
      radial-gradient(60% 50% at 50% 60%, rgb(30 80 255 / 0.18), transparent 70%);
  }

  .ev-in {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1rem;
  }
  .ev-pastilla {
    margin: 0;
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.14);
    color: #cfe0ff;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .ev-in h2 {
    font-size: clamp(2.2rem, 1.1rem + 3.6vw, 4rem);
    color: #19d3e0;
  }
  .ev-sub {
    margin: 0;
    font-size: clamp(1.1rem, 0.95rem + 0.7vw, 1.5rem);
    font-weight: 800;
    font-stretch: 112%;
  }
  .ev-nota {
    margin: 0;
    color: #c9cfea;
  }

  .ev-redes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(0.5rem, 2vw, 1.4rem);
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
  }
  .app-ico {
    display: grid;
    place-items: center;
    width: clamp(46px, 12.5vw, 96px);
    height: clamp(46px, 12.5vw, 96px);
    border-radius: 24%;
    color: #fff;
    overflow: hidden;
    box-shadow: 0 14px 30px -12px rgb(0 0 0 / 0.7);
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .app-ico:hover {
    transform: translateY(-6px) scale(1.04);
  }
  .app-ico :global(svg) {
    width: 56%;
    height: 56%;
  }
  .app-ico img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .wt {
    background: #3a55f2;
  }
  /* Los PNG originales traen sombra alrededor del ícono: se amplían para que el color llene la tarjeta */
  .app-ico img {
    transform: scale(1.2);
  }
  .tg {
    background: linear-gradient(180deg, #37bbfe, #007dbb);
  }
  .ev-siguenos {
    margin: 0.4rem 0 0;
    font-size: 0.75rem;
    font-weight: 700;
    color: #c9cfea;
  }
</style>
